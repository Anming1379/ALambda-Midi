<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 基础色板：沿用原来的黑色系 -->
    <SolidColorBrush x:Key="BgBrush"            Color="#0E0E10"/>
    <SolidColorBrush x:Key="PanelBrush"         Color="#18181B"/>
    <SolidColorBrush x:Key="BorderLineBrush"    Color="#27272A"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#FAFAFA"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#71717A"/>
    <SolidColorBrush x:Key="TextDimBrush"       Color="#5C5A66"/>

    <!-- 主题点缀色：紫色（只在关键处少量使用） -->
    <SolidColorBrush x:Key="AccentBrush"        Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="#A78BFA"/>
    <SolidColorBrush x:Key="AccentDeepBrush"    Color="#4C1D95"/>
    <SolidColorBrush x:Key="AccentTintBrush"    Color="#268B5CF6"/>

    <SolidColorBrush x:Key="HoverBrush"         Color="#27272A"/>
</ResourceDictionary>
