<Window x:Class="MidiPlayer.Controls.PianoKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="钢琴键盘"
        Width="900" Height="260"
        MinWidth="500" MinHeight="200"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="4"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border x:Name="TitleBar" Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="钢琴键盘" Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnOctDown" Content="&#xe5cb;"
                                Style="{StaticResource IconButton}" Width="32" Height="32"
                                ToolTip="八度 -1"/>
                        <Button x:Name="BtnOctUp" Content="&#xe5cc;"
                                Style="{StaticResource IconButton}" Width="32" Height="32"
                                ToolTip="八度 +1"/>
                        <Button x:Name="BtnClose" Content="✕"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Background="Transparent" BorderThickness="0"
                                FontSize="12" Width="32" Height="32"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 钢琴画布 -->
            <skia:SKElement x:Name="PianoCanvas" Grid.Row="1"
                            IgnorePixelScaling="True"/>

            <!-- 状态栏 -->
            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <TextBlock x:Name="LblRange" Text="C4 - B7"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Shift 踏板 · Shift + ←/→ 移八度 · 鼠标可点"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>