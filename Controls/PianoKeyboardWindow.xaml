<Window x:Class="MidiPlayer.Controls.PianoKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="钢琴键盘"
        Width="900" Height="280"
        MinWidth="520" MinHeight="240"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="4"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border x:Name="TitleBar" Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="钢琴键盘" Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnOctDown" Content="&#xe5cb;"
                                Style="{StaticResource IconButton}" Width="32" Height="32"
                                ToolTip="八度 -1（Ctrl + ← / 滚轮向下）"/>
                        <Button x:Name="BtnOctUp" Content="&#xe5cc;"
                                Style="{StaticResource IconButton}" Width="32" Height="32"
                                ToolTip="八度 +1（Ctrl + → / 滚轮向上）"/>
                        <Button x:Name="BtnClose" Content="✕"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Background="Transparent" BorderThickness="0"
                                FontSize="12" Width="32" Height="32"
                                Cursor="Hand" ToolTip="关闭"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 钢琴画布。PianoHost 负责裁切，切换八度时画布可以左右滑入 -->
            <Grid x:Name="PianoHost" Grid.Row="1" ClipToBounds="True">
                <skia:SKElement x:Name="PianoCanvas"
                                IgnorePixelScaling="True"/>
            </Grid>

            <!-- 状态栏 -->
            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="LblRange" Text="C4 - B6"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource UiFont}" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <Border Width="1" Height="12" Margin="10,0"
                                Background="{StaticResource BorderLineBrush}"/>
                        <Button x:Name="BtnPedal"
                                Style="{StaticResource TextButton}"
                                Height="22" Padding="8,0" BorderThickness="1"
                                Focusable="False"
                                ToolTip="点击锁定 / 松开踏板；Shift 或 空格按住也可以">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="PedalDot" Width="7" Height="7"
                                         Fill="{StaticResource TextDimBrush}"
                                         VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="PedalDotScale"
                                                        CenterX="3.5" CenterY="3.5"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock x:Name="LblPedal" Text="踏板 关"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource UiFont}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Shift / 空格 踏板 · Ctrl+←/→ 或滚轮 移八度 · 鼠标可点"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="14,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
