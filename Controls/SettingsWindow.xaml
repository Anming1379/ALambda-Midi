<Window x:Class="MidiPlayer.Controls.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="设置"
        Width="660" Height="640"
        MinWidth="660" MinHeight="520"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="4"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="ALambda Midi" Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button x:Name="BtnClose" Content="✕"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Background="Transparent" BorderThickness="0"
                            FontSize="12" Width="32" Height="32"
                            HorizontalAlignment="Right" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- 标签页 -->
            <TabControl x:Name="Tabs" Grid.Row="1"
                        Style="{StaticResource FlatTabControl}">

                <!-- ============ 设置 ============ -->
                <TabItem Header="设置" Style="{StaticResource FlatTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,16">
                        <StackPanel>

<TextBlock Text="文件关联" Foreground="{StaticResource TextSecondaryBrush}"
           FontFamily="{StaticResource UiFont}" FontSize="11"
           Margin="0,0,0,6"/>

<Grid Margin="0,3,0,4">
    <TextBlock Text="把 .mid 文件与本程序关联"
               Foreground="{StaticResource TextPrimaryBrush}"
               FontFamily="{StaticResource UiFont}" FontSize="13"
               VerticalAlignment="Center"/>
    <Button x:Name="BtnAssociate" HorizontalAlignment="Right"
            Style="{StaticResource TextButton}"
            Content="注册" Width="72"/>
</Grid>
<TextBlock x:Name="LblAssocHint"
           Text="注册后可在右键菜单中看到 ALambda Midi"
           Foreground="{StaticResource TextSecondaryBrush}"
           FontFamily="{StaticResource UiFont}" FontSize="11"
           TextWrapping="Wrap"
           Margin="0,0,0,14"/>



                            <TextBlock Text="音乐库" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource UiFont}" FontSize="11"
                                       Margin="0,0,0,6"/>
                            <Grid Margin="0,3,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtLibraryFolder" Grid.Column="0"
                                         Background="{StaticResource PanelBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource BorderLineBrush}"
                                         BorderThickness="1"
                                         FontFamily="{StaticResource UiFont}" FontSize="12"
                                         Padding="6,5" Margin="0,0,8,0"/>
                                <Button x:Name="BtnBrowseLibrary" Grid.Column="1"
                                        Style="{StaticResource TextButton}"
                                        Content="浏览" Width="60"/>
                            </Grid>

                            <TextBlock Text="界面" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource UiFont}" FontSize="11"
                                       Margin="0,0,0,6"/>

                            <Grid Margin="0,3">
                                <TextBlock Text="背景色" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="{StaticResource UiFont}" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="BtnBg" Style="{StaticResource SettingsSwatch}" HorizontalAlignment="Right">
                                    <Border x:Name="SwBg" Width="22" Height="22"
                                            BorderBrush="#5A5A5F" BorderThickness="1" Background="#0A0E14"/>
                                </Button>
                            </Grid>

                            <Grid Margin="0,3">
                                <TextBlock Text="判定线" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="{StaticResource UiFont}" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="BtnPlayhead" Style="{StaticResource SettingsSwatch}" HorizontalAlignment="Right">
                                    <Border x:Name="SwPlayhead" Width="22" Height="22"
                                            BorderBrush="#5A5A5F" BorderThickness="1" Background="#FFFFFF"/>
                                </Button>
                            </Grid>

                            <Grid Margin="0,14,0,6">
                                <TextBlock Text="网格线" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource UiFont}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkShowGrid" Style="{StaticResource FlatCheckBox}"
                                          Content="显示" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <TextBlock Text="弱拍" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="{StaticResource UiFont}" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="BtnGridWeak" Style="{StaticResource SettingsSwatch}" HorizontalAlignment="Right">
                                    <Border x:Name="SwGridWeak" Width="22" Height="22"
                                            BorderBrush="#5A5A5F" BorderThickness="1" Background="#14FFFFFF"/>
                                </Button>
                            </Grid>

                            <Grid Margin="0,3">
                                <TextBlock Text="强拍（小节线）" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="{StaticResource UiFont}" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="BtnGridStrong" Style="{StaticResource SettingsSwatch}" HorizontalAlignment="Right">
                                    <Border x:Name="SwGridStrong" Width="22" Height="22"
                                            BorderBrush="#5A5A5F" BorderThickness="1" Background="#32FFFFFF"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="音符" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource UiFont}" FontSize="11"
                                       Margin="0,14,0,6"/>

                            <Grid Margin="0,3">
                                <TextBlock Text="未激活" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="{StaticResource UiFont}" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="BtnNoteInactive" Style="{StaticResource SettingsSwatch}" HorizontalAlignment="Right">
                                    <Border x:Name="SwNoteInactive" Width="22" Height="22"
                                            BorderBrush="#5A5A5F" BorderThickness="1" Background="#3CFFFFFF"/>
                                </Button>
                            </Grid>

                            <Grid Margin="0,3">
                                <TextBlock Text="激活" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="{StaticResource UiFont}" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="BtnNoteActive" Style="{StaticResource SettingsSwatch}" HorizontalAlignment="Right">
                                    <Border x:Name="SwNoteActive" Width="22" Height="22"
                                            BorderBrush="#5A5A5F" BorderThickness="1" Background="#FFFFFF"/>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ 教程 ============ -->
                <TabItem Header="教程" Style="{StaticResource FlatTabItem}">
                    <Border Background="#18181B">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,20">
                            <StackPanel>

                                <TextBlock Text="快速开始" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#E4E4E7"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="22"
                                           Foreground="#C8C8CC"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,22">
                                    • 先在工具栏下拉框选择 MIDI 输出端口（例如 Microsoft GS Wavetable Synth、Pianoteq、loopMIDI）<LineBreak/>
                                    • 按 Ctrl+O 打开 .mid / .midi，或直接把文件拖进窗口<LineBreak/>
                                    • 右键「用 ALambda Midi 打开」加载文件后会自动开始播放<LineBreak/>
                                    • 空格播放 / 暂停；Esc 停止并回到开头<LineBreak/>
                                    • 在设置里指定 MIDI 库文件夹后，侧边栏会递归列出里面的 MIDI 文件
                                </TextBlock>

                                <TextBlock Text="主界面快捷键" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#E4E4E7"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,10"/>
                                <TextBlock FontFamily="{StaticResource UiFont}" FontSize="12"
                                           LineHeight="24" TextWrapping="Wrap"
                                           Foreground="#C8C8CC" Margin="0,0,0,8">
                                    <Run Text="空格" Foreground="#A78BFA" FontFamily="Consolas"/>  播放 / 暂停<LineBreak/>
                                    <Run Text="Esc" Foreground="#A78BFA" FontFamily="Consolas"/>  停止并回到开头<LineBreak/>
                                    <Run Text="← / →" Foreground="#A78BFA" FontFamily="Consolas"/>  快退 / 快进 5 秒<LineBreak/>
                                    <Run Text="Home" Foreground="#A78BFA" FontFamily="Consolas"/>  回到开头<LineBreak/>
                                    <Run Text="↑ / ↓" Foreground="#A78BFA" FontFamily="Consolas"/>  升调 / 降调 ±1（可长按）<LineBreak/>
                                    <Run Text="Ctrl + ← / →" Foreground="#A78BFA" FontFamily="Consolas"/>  上一首 / 下一首（同文件夹）<LineBreak/>
                                    <Run Text="Ctrl + O" Foreground="#A78BFA" FontFamily="Consolas"/>  打开文件<LineBreak/>
                                    <Run Text="Ctrl + H" Foreground="#A78BFA" FontFamily="Consolas"/>  横版 / 竖版切换<LineBreak/>
                                    <Run Text="Ctrl + L" Foreground="#A78BFA" FontFamily="Consolas"/>  循环模式：无 / 列表 / 随机（仅当前文件夹）<LineBreak/>
                                    <Run Text="Ctrl + B" Foreground="#A78BFA" FontFamily="Consolas"/>  显示 / 隐藏 MIDI 库<LineBreak/>
                                    <Run Text="Ctrl + E" Foreground="#A78BFA" FontFamily="Consolas"/>  打开 / 返回 MIDI 编辑器<LineBreak/>
                                    <Run Text="Ctrl + N" Foreground="#A78BFA" FontFamily="Consolas"/>  新建空 MIDI<LineBreak/>
                                    <Run Text="Ctrl + P" Foreground="#A78BFA" FontFamily="Consolas"/>  钢琴键盘<LineBreak/>
                                    <Run Text="Ctrl + ," Foreground="#A78BFA" FontFamily="Consolas"/>  打开设置<LineBreak/>
                                    <Run Text="Ctrl + D" Foreground="#A78BFA" FontFamily="Consolas"/>  停止并复位<LineBreak/>
                                    <Run Text="[ / ]" Foreground="#A78BFA" FontFamily="Consolas"/>  BPM -5 / +5（主界面）
                                </TextBlock>
                                <TextBlock Text="组合键用于防误触；长按空格不会连续触发播放 / 暂停。"
                                           TextWrapping="Wrap"
                                           Foreground="#A1A1AA"
                                           FontFamily="{StaticResource UiFont}" FontSize="11"
                                           Margin="0,0,0,22"/>

                                <TextBlock Text="可视化与播放" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#E4E4E7"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="22"
                                           Foreground="#C8C8CC"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,22">
                                    • 竖版瀑布：音符从上方落下，底部是钢琴键盘<LineBreak/>
                                    • 横版卷轴：音符从右向左移动，中间是判定线<LineBreak/>
                                    • 音符碰到判定线的瞬间就是开始播放的时刻，会变亮后淡出<LineBreak/>
                                    • BPM 和移调互不影响：BPM 改速度，移调改音高<LineBreak/>
                                    • 进度条可点击或拖动跳转；播放前会自动发送踏板复位，避免 Sustain 残留
                                </TextBlock>

                                <TextBlock Text="钢琴键盘（Ctrl+P）" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#E4E4E7"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="22"
                                           Foreground="#C8C8CC"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,22">
                                    • 点击琴键或按住拖动滑奏；电脑键盘 Z 行是低八度，Q 行是高八度<LineBreak/>
                                    • Shift 或 空格按住 = 踏板；底部「踏板 关/开」按钮可以点击锁定，状态会实时显示<LineBreak/>
                                    • Ctrl + ←/→ 或鼠标滚轮切换八度；Shift + ←/→ 保留旧习惯<LineBreak/>
                                    • 琴键有悬停高亮和按下 / 松开动画；白键标注音名；失焦或关闭会自动松开所有音与踏板
                                </TextBlock>

                                <TextBlock Text="音乐库与循环" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#E4E4E7"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="22"
                                           Foreground="#C8C8CC"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,22">
                                    • 在设置里选择一个文件夹作为 MIDI 库，侧边栏会递归列出所有 .mid / .midi<LineBreak/>
                                    • 直接打开或拖入的文件不会加入音乐库<LineBreak/>
                                    • 上一首 / 下一首 / 列表循环 / 随机只作用于「当前 MIDI 所在文件夹」<LineBreak/>
                                    • 工具栏的循环按钮会在「不循环 → 列表循环 → 随机」之间切换
                                </TextBlock>

                                <TextBlock Text="MIDI 编辑器" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#E4E4E7"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="22"
                                           Foreground="#C8C8CC"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,22">
                                    • 工具栏「MIDI 编辑器」打开当前 MIDI；没有打开文件时新建空 MIDI<LineBreak/>
                                    • 整页切换，不弹新窗口；钢琴窗 / 鼓编辑器一键切换<LineBreak/>
                                    • 左键放音符 / 拖动，拖右边缘改长度；右键删除，右键滑动可连续删除<LineBreak/>
                                    • 多选后拖任意选中音符的右边缘，可以一起改所有选中音符的时值<LineBreak/>
                                    • 新音符会淡入放大，删除音符会留下 180ms 的缩小淡出残影<LineBreak/>
                                    • Shift + 拖动框选（会在已有选中上叠加，不会清空之前的选中）<LineBreak/>
                                    • 自适应吸附：随缩放自动在 1/1 ~ 1/32 之间切换，状态栏显示当前精度<LineBreak/>
                                    • 工具栏 BPM 输入框：输入后回车应用，[ / ] 每次 ±5；播放中改 BPM 会从当前位置重播<LineBreak/>
                                    • 滚轮上下滚动，Shift + 滚轮左右滚动，Ctrl + 滚轮横向缩放，Alt + 滚轮纵向缩放<LineBreak/>
                                    • 下方力度 / 踏板区：Tab 切换页面；力度拖动竖条，踏板左键画上、右键擦除<LineBreak/>
                                    • 拖动分隔条或双击编辑区标题可收起 / 展开编辑区<LineBreak/>
                                    • 框选后 Ctrl+C / Ctrl+X 复制 / 剪切，Ctrl+V 粘贴到播放头；Delete / Backspace 删除<LineBreak/>
                                    • Ctrl+Z / Ctrl+Y 撤销 / 重做；Ctrl+S 快速保存<LineBreak/>
                                    • 工具栏保存按钮始终打开保存窗口，可改名称 / 目录 / BPM / 拍号；路径会完整换行显示<LineBreak/>
                                    • 打开已有 MIDI 时保存窗口默认指回源文件，确认覆盖后源文件 BPM 会更新；新建 MIDI 才默认保存到音乐/ALambda Midi<LineBreak/>
                                    • 保存成功后主界面会载入实际保存的文件，BPM 与磁盘一致
                                </TextBlock>

                                <TextBlock Text="编辑器快捷键" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#E4E4E7"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,10"/>
                                <TextBlock FontFamily="{StaticResource UiFont}" FontSize="12"
                                           LineHeight="24" TextWrapping="Wrap"
                                           Foreground="#C8C8CC" Margin="0,0,0,8">
                                    <Run Text="空格" Foreground="#A78BFA" FontFamily="Consolas"/>  播放 / 暂停<LineBreak/>
                                    <Run Text="Esc" Foreground="#A78BFA" FontFamily="Consolas"/>  返回主界面（会询问保存）<LineBreak/>
                                    <Run Text="Tab" Foreground="#A78BFA" FontFamily="Consolas"/>  切换力度 / 踏板编辑页<LineBreak/>
                                    <Run Text="Ctrl + S" Foreground="#A78BFA" FontFamily="Consolas"/>  快速保存<LineBreak/>
                                    <Run Text="Ctrl + N" Foreground="#A78BFA" FontFamily="Consolas"/>  新建空 MIDI<LineBreak/>
                                    <Run Text="Ctrl + C / X" Foreground="#A78BFA" FontFamily="Consolas"/>  复制 / 剪切选中音符<LineBreak/>
                                    <Run Text="Ctrl + V" Foreground="#A78BFA" FontFamily="Consolas"/>  粘贴到播放头<LineBreak/>
                                    <Run Text="Ctrl + Z / Y" Foreground="#A78BFA" FontFamily="Consolas"/>  撤销 / 重做<LineBreak/>
                                    <Run Text="Ctrl + E" Foreground="#A78BFA" FontFamily="Consolas"/>  返回主界面<LineBreak/>
                                    <Run Text="↑ / ↓" Foreground="#A78BFA" FontFamily="Consolas"/>  选中音符升 / 降 1 半音<LineBreak/>
                                    <Run Text="Shift + ↑ / ↓" Foreground="#A78BFA" FontFamily="Consolas"/>  升 / 降一个八度<LineBreak/>
                                    <Run Text="← / →" Foreground="#A78BFA" FontFamily="Consolas"/>  按小节移动播放头<LineBreak/>
                                    <Run Text="Home" Foreground="#A78BFA" FontFamily="Consolas"/>  回到开头<LineBreak/>
                                    <Run Text="Delete / Backspace" Foreground="#A78BFA" FontFamily="Consolas"/>  删除选中音符<LineBreak/>
                                    <Run Text="[ / ]" Foreground="#A78BFA" FontFamily="Consolas"/>  BPM -5 / +5
                                </TextBlock>
                                <TextBlock Text="编辑器里的 Tab 专门用于切换力度 / 踏板页，所以不会用来移动输入焦点。"
                                           TextWrapping="Wrap"
                                           Foreground="#A1A1AA"
                                           FontFamily="{StaticResource UiFont}" FontSize="11"
                                           Margin="0,0,0,22"/>

                                <TextBlock Text="安装版 / 便携版" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#E4E4E7"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="22"
                                           Foreground="#C8C8CC"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,22">
                                    • 安装版：ALambdaMidi_Setup_v2.4.exe，不自带 .NET；安装时会自动检测并安装 .NET 10 桌面运行时<LineBreak/>
                                    • 便携版：ALambdaMidi-Portable-v2.4-win-x64.zip，自包含运行时，解压后直接运行 ALambdaMidi.exe<LineBreak/>
                                    • 两个版本都把设置保存在 %AppData%\ALambda Midi\config.json，升级或移动程序不会丢失
                                </TextBlock>

                                <TextBlock Text="配置文件" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#E4E4E7"
                                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="22"
                                           Foreground="#C8C8CC"
                                           FontFamily="{StaticResource UiFont}">
                                    • 设置、颜色、音乐库目录、上次打开的文件和编辑器保存记忆保存在<LineBreak/>
                                      %AppData%\ALambda Midi\config.json<LineBreak/>
                                    • 可以手工编辑该文件，下次启动生效；删除它相当于恢复默认设置<LineBreak/>
                                    • 编辑器默认保存目录：音乐\ALambda Midi
                                </TextBlock>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- ============ 关于 ============ -->
                <TabItem Header="关于" Style="{StaticResource FlatTabItem}">
                    <Border Background="#18181B">
                        <StackPanel Margin="40,40,40,40">
                            <TextBlock Text="ALambda Midi"
                                       Foreground="#E4E4E7"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LblVersion" Text="v2.4"
                                       Foreground="#A1A1AA"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="12" Margin="0,6,0,0"/>

                            <Rectangle Height="1" Fill="#27272A" Margin="0,24,0,20"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="作者"
                                           Foreground="#A1A1AA"
                                           FontFamily="{StaticResource UiFont}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Anming_cat"
                                           Foreground="#E4E4E7"
                                           FontFamily="{StaticResource UiFont}" FontSize="12" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="主页"
                                           Foreground="#A1A1AA"
                                           FontFamily="{StaticResource UiFont}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                    <Hyperlink x:Name="LinkAuthor"
                                               Foreground="#A78BFA"
                                               TextDecorations="None"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="12">anmingcat.pages.dev</Hyperlink>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="仓库"
                                           Foreground="#A1A1AA"
                                           FontFamily="{StaticResource UiFont}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="https://github.com/Anming1379/ALambda-Midi/"
                                           Foreground="#E4E4E7"
                                           FontFamily="{StaticResource UiFont}" FontSize="12" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="协议"
                                           Foreground="#A1A1AA"
                                           FontFamily="{StaticResource UiFont}" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT License"
                                           Foreground="#E4E4E7"
                                           FontFamily="{StaticResource UiFont}" FontSize="12"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#27272A" Margin="0,24,0,16"/>

                            <TextBlock Text="代码由 AI 生成"
                                       Foreground="#A1A1AA"
                                       FontFamily="{StaticResource UiFont}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </TabItem>

            </TabControl>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <Button x:Name="BtnCancel" Content="取消"
                        Style="{StaticResource TextButton}" Width="80" Margin="0,0,8,0"/>
                <Button x:Name="BtnOk" Content="确定"
                        Style="{StaticResource TextButton}" Width="80"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>