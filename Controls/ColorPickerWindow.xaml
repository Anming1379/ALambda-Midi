<Window x:Class="MidiPlayer.Controls.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="颜色选择器"
        Width="340" Height="640"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="颜色选择器"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button x:Name="BtnClose" Content="✕"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Background="Transparent" BorderThickness="0"
                            FontSize="12" Width="32" Height="32"
                            HorizontalAlignment="Right" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- 内容 -->
            <StackPanel Grid.Row="1">
                <!-- 色轮 + SV 正方形 -->
                <skia:SKElement x:Name="WheelCanvas"
                                Width="300" Height="300"
                                HorizontalAlignment="Center"
                                IgnorePixelScaling="True"/>

                <!-- H 滑条 -->
                <Grid Margin="20,4,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="H"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <skia:SKElement x:Name="HueCanvas" Grid.Column="1"
                                    Height="16" Margin="4,0,4,0"
                                    VerticalAlignment="Center"
                                    IgnorePixelScaling="True"/>
                    <TextBlock x:Name="LblH" Grid.Column="2" Text="0"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <!-- S 滑条 -->
                <Grid Margin="20,8,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="S"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <skia:SKElement x:Name="SatCanvas" Grid.Column="1"
                                    Height="16" Margin="4,0,4,0"
                                    VerticalAlignment="Center"
                                    IgnorePixelScaling="True"/>
                    <TextBlock x:Name="LblS" Grid.Column="2" Text="0"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <!-- V 滑条 -->
                <Grid Margin="20,8,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="V"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <skia:SKElement x:Name="ValCanvas" Grid.Column="1"
                                    Height="16" Margin="4,0,4,0"
                                    VerticalAlignment="Center"
                                    IgnorePixelScaling="True"/>
                    <TextBlock x:Name="LblV" Grid.Column="2" Text="100"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Hex + 预览 -->
                <Grid Margin="20,12,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HexBox" Grid.Column="0"
                             Background="{StaticResource PanelBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderLineBrush}"
                             BorderThickness="1"
                             FontFamily="Consolas" FontSize="13"
                             Padding="8,6" Margin="0,0,8,0"/>
                    <Border x:Name="PreviewBorder" Grid.Column="1"
                            BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"/>
                </Grid>

                <!-- 预设 -->
                <WrapPanel x:Name="PresetPanel" Margin="20,12,20,0"/>
            </StackPanel>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <Button x:Name="BtnCancel" Content="取消"
                        Style="{StaticResource TextButton}" Width="80" Margin="0,0,8,0"/>
                <Button x:Name="BtnOk" Content="确定"
                        Style="{StaticResource TextButton}" Width="80"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>